# Used by packages/server's AI review step (see packages/server/src/ai.mjs).
# Without it, the AI reviewer is skipped (a TestSessionAiError is caught and
# swallowed) — the tester's comment still saves either way.
ANTHROPIC_API_KEY=

# Used only by packages/server's own test suite, against a local/CI Postgres
# that already has this package's migration applied.
DATABASE_URL=postgres://localhost:5432/tracewrite_test
