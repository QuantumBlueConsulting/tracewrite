{
  "name": "@quantumblueconsulting/tracewrite-server",
  "version": "0.5.0",
  "description": "tracewrite's backend: session/timeline logic plus Fastify and Express adapters, both host-agnostic (bring your own pg Pool and auth).",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuantumBlueConsulting/tracewrite.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo \"no build step \u2014 plain ESM\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"no lint configured yet\"",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  },
  "peerDependencies": {
    "fastify": "^5.1.0",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/express": "^4.17.21",
    "@fastify/jwt": "^9.0.0",
    "fastify": "^5.1.0",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.0"
  },
  "types": "./src/index.d.mts",
  "license": "MIT",
  "author": "QuantumBlue Consulting",
  "homepage": "https://github.com/QuantumBlueConsulting/tracewrite#readme",
  "bugs": {
    "url": "https://github.com/QuantumBlueConsulting/tracewrite/issues"
  },
  "keywords": [
    "uat",
    "user-acceptance-testing",
    "qa",
    "feedback",
    "fastify",
    "express",
    "postgres",
    "ai"
  ]
}
